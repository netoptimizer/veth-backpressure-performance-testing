C veth-handoff-full+flush-only

(*
 * Result: Never
 *
 * As veth-handoff, with more of the driver logic.
 *
 * P0: producer: ptr_ring_produce(), then __veth_xdp_flush().
 * P1: NAPI kthread, one poll.  It consumes the ring entry, completes
 *     NAPI, clears rx_notify_masked, checks the ring again and re-arms
 *     NAPI when the ring is not empty.  When napi_complete_done() finds
 *     MISSED, it schedules NAPI again and the test ends.
 *
 * The re-arm here runs on the kthread itself, so it needs no barrier:
 * flush-only and helper give the same result.
 *
 * smp_wmb(): in __veth_xdp_flush() only.  This is the first version of
 * the fix.  The re-arm path in veth_poll() has no barrier.
 *
 * Bad state: NAPI is idle (state == 0) and rx_notify_masked is still
 * true, or NAPI is idle and the ring still holds an entry.
 *
 * napi->state is one word: state = count + 16 * T
 *   count: 0 = idle, 1 = SCHED, 2 = SCHED | MISSED
 *   T:     SCHED_THREADED
 *)

{
	atomic_t state = ATOMIC_INIT(0);
	int masked = 0;
	int ring = 0;
}

P0(atomic_t *state, int *masked, int *ring)
{
	int m1;
	int o1;

	WRITE_ONCE(*ring, 1); /* ptr_ring_produce() */
	smp_mb(); /* __veth_xdp_flush() */
	m1 = READ_ONCE(*masked);
	if (m1 == 0) {
		o1 = atomic_fetch_add(1, state); /* napi_schedule_prep() */
		if (o1 == 0) {
			WRITE_ONCE(*masked, 1);
			smp_wmb(); /* the fix */
			atomic_or(16, state); /* set_bit(SCHED_THREADED) */
		}
	}
}

P1(atomic_t *state, int *masked, int *ring)
{
	int t1;
	int c1;
	int o1;
	int e1;
	int o2;

	t1 = atomic_read(state); /* test_bit(SCHED_THREADED) */
	if (t1 & 16) {
		c1 = READ_ONCE(*ring); /* veth_xdp_rcv() */
		if (c1 == 1) {
			WRITE_ONCE(*ring, 0);
		}
		o1 = atomic_fetch_sub(17, state); /* napi_complete_done() */
		if (o1 == 17) {
			WRITE_ONCE(*masked, 0); /* smp_store_mb() */
			smp_mb();
			e1 = READ_ONCE(*ring); /* !__ptr_ring_empty() */
			if (e1 == 1) {
				o2 = atomic_fetch_add(1, state); /* napi_schedule_prep() */
				if (o2 == 0) {
					WRITE_ONCE(*masked, 1);
					atomic_or(16, state); /* set_bit(SCHED_THREADED) */
				}
			}
		} else {
			atomic_or(16, state); /* MISSED: __napi_schedule() */
		}
	}
}

exists (state=0 /\ (masked=1 \/ ring=1))
